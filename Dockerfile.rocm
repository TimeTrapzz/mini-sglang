ARG BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2-complete
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12-venv git build-essential libstdc++-14-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app

COPY scripts/build-amd-flashinfer.sh ./scripts/
RUN python -m pip install --no-cache-dir 'torch==2.11.0+rocm7.2' \
        --index-url https://download.pytorch.org/whl/rocm7.2 \
    && bash scripts/build-amd-flashinfer.sh /wheels \
    && python -m pip install --no-cache-dir /wheels/*.whl

COPY pyproject.toml README.md ./
COPY python/ ./python/

RUN python -m pip install --no-cache-dir -e ".[rocm]"

RUN mkdir -p /app/.cache/huggingface /app/.cache/flashinfer

ENV ROCM_HOME=/opt/rocm
ENV ROCM_PATH=/opt/rocm
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
ENV FLASHINFER_WORKSPACE_BASE=/app/.cache/flashinfer

EXPOSE 1919

ENTRYPOINT ["python", "-m", "minisgl"]
CMD ["--help"]
